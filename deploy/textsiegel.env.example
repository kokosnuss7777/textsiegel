# Copied to textsiegel.env by install.sh and filled with random values. Never commit it.

# Choice-Point-Mark and internal signature: must be the same key the chatbot marks with.
MARK_KEY=
CUSTOMER_ID=1

# Public provenance (Ed25519) and signed reports
TEXTSIEGEL_ED25519_KEY_FILE=/data/textsiegel-ed25519.pem
TEXTSIEGEL_KEY_ID=1
RECORDS_DIR=/data/records

# Public base URL (identifier in reports, links on the about page)
SERVICE_URL=https://example.org
PROVIDER_NAME=Example provider
CONTACT=

# Comma-separated tokens for authorities, press, researchers (statistic visible, no rate limit)
EXPERT_TOKENS=
RATE_LIMIT=60

# 1 = test page at / enabled (only while the service is not publicly reachable)
TEST_PAGE=0
